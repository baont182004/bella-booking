# Production backend example for AWS EC2 Docker Compose.
# Copy to `.env.prod` on the server and replace placeholders with real secrets.

NODE_ENV=production

# Public URLs
FRONTEND_URL=https://bella-booking.vercel.app
FRONTEND_PUBLIC_URL=https://bella-booking.vercel.app
BACKEND_PUBLIC_URL=https://bella-booking-api.duckdns.org
PAYMENT_PUBLIC_BASE_URL=https://bella-booking-api.duckdns.org
CORS_ORIGINS=https://bella-booking.vercel.app,https://bella-booking-api.duckdns.org,http://localhost:5173,http://localhost:3000
# Backward-compatible alias for older service configs.
CORS_ORIGIN=https://bella-booking.vercel.app,https://bella-booking-api.duckdns.org,http://localhost:5173,http://localhost:3000

# Internal Docker service endpoints
MONGO_URI=mongodb://mongo:27017/bella_booking
# Backward-compatible alias used by existing service code and scripts.
MONGODB_URI=mongodb://mongo:27017/bella_booking
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Backward-compatible alias used by existing service code and scripts.
KAFKA_BROKER=kafka:9092

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=12h
TRUST_PROXY=1

# Demo admin bootstrap. Keep disabled unless you intentionally want the service to create/sync an admin.
ENABLE_DEMO_ADMIN_BOOTSTRAP=false
DEMO_ADMIN_SYNC_PASSWORD=false
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=your_demo_admin_password_here
DEMO_ADMIN_FIRST_NAME=Demo
DEMO_ADMIN_LAST_NAME=Admin
DEMO_ADMIN_PHONE=

# Booking/payment runtime
# `mock` supports hosted sandbox card and bank-transfer checkout for demos.
PAYMENT_PROVIDER=mock
PAYMENT_CHECKOUT_TTL_MINUTES=30
PAYMENT_HOLD_WINDOW_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# HMAC secret used only to verify mock provider webhook/callback payloads.
MOCK_PAYMENT_WEBHOOK_SECRET=your_mock_webhook_secret_here
MONGODB_TRANSACTIONS_ENABLED=false

# Stripe sandbox/live values. Required only when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=

# payOS sandbox/live QR bank checkout. Required only when PAYMENT_PROVIDER=payos.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://bella-booking.vercel.app/payments/return
PAYOS_CANCEL_URL=https://bella-booking.vercel.app/payments/return
PAYOS_WEBHOOK_URL=https://bella-booking-api.duckdns.org/payments/webhooks/payos
PAYOS_API_BASE_URL=https://api-merchant.payos.vn

# Notification email. Required for real email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hotel metadata file mounted by docker-compose.prod.yml.
BELLA_METADATA_FILE=/app/data/bella-room-metadata.json
