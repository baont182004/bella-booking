# __ Server ____________________________________________________________________
PORT=3005
NODE_ENV=development

# __ Kafka _____________________________________________________________________
KAFKA_BROKER=localhost:9092

# __ JWT _______________________________________________________________________
# Required for admin-only notification send endpoint.
JWT_SECRET=change_me_to_a_long_random_secret

# __ SMTP (Nodemailer) _________________________________________________________
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
