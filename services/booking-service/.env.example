# __ Server ____________________________________________________________________
PORT=3003
NODE_ENV=development

# __ MongoDB / Redis / Kafka ___________________________________________________
MONGODB_URI=mongodb://127.0.0.1:27017/bella_hotel
REDIS_HOST=localhost
REDIS_PORT=6379
# When booking-service runs directly on the host against repo docker-compose dependencies,
# Kafka is exposed on localhost:9093. In-container services use `kafka:9092` instead.
KAFKA_BROKER=localhost:9093

# __ JWT / CORS ________________________________________________________________
# Secret. Must match user-service JWT secret.
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Internal deployment setting. Use the exact trusted proxy hop count, `true`, or `false`.
TRUST_PROXY=1

# __ Booking hold / consistency settings _______________________________________
# Minutes Bella keeps a pending booking before payment is expected.
PAYMENT_HOLD_WINDOW_MINUTES=30
# Enable only on a MongoDB replica set so booking state and outbox inserts can commit atomically.
MONGODB_TRANSACTIONS_ENABLED=false

# Booking-service does not call a payment provider directly.
# Do not place provider API secrets here.
