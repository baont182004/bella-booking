REDIS_PORT=6379

# __ Kafka _____________________________________________________________________
KAFKA_BROKER=localhost:9092

# __ JWT _______________________________________________________________________
# Must match user-service JWT secret.
JWT_SECRET=change_me_to_a_long_random_secret
