# __ Server ____________________________________________________________________
PORT=3003
NODE_ENV=development

# __ MongoDB Atlas (via Mongoose) _____________________________________________
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.tc3alix.mongodb.net/?appName=Cluster0

# __ Redis _____________________________________________________________________
