# __ Server ____________________________________________________________________
PORT=3001
NODE_ENV=development

# __ MongoDB / Redis ___________________________________________________________
MONGODB_URI=mongodb://127.0.0.1:27017/bella_hotel
REDIS_HOST=localhost
REDIS_PORT=6379

# __ Auth / CORS _______________________________________________________________
# Secret. Must match the JWT secret used by booking-service and payment-service.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Internal deployment setting. Use the exact trusted proxy hop count, `true`, or `false`.
TRUST_PROXY=1

# __ Optional demo admin bootstrap _____________________________________________
ENABLE_DEMO_ADMIN_BOOTSTRAP=true
DEMO_ADMIN_SYNC_PASSWORD=true
DEMO_ADMIN_EMAIL=admin.bella@example.com
DEMO_ADMIN_PASSWORD=Password123!
DEMO_ADMIN_FIRST_NAME=Bella
DEMO_ADMIN_LAST_NAME=Admin
DEMO_ADMIN_PHONE=+84 900 000 001
