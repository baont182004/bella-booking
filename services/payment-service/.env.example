# __ Server ____________________________________________________________________
PORT=3004
NODE_ENV=development

# __ MongoDB / Redis / Kafka ___________________________________________________
MONGODB_URI=mongodb://127.0.0.1:27017/bella_hotel
REDIS_HOST=localhost
REDIS_PORT=6379
# When payment-service runs directly on the host against repo docker-compose dependencies,
# Kafka is exposed on localhost:9093. In-container services use `kafka:9092` instead.
KAFKA_BROKER=localhost:9093

# __ JWT / CORS ________________________________________________________________
# Secret. Must match user-service JWT secret.
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Internal deployment setting. Use the exact trusted proxy hop count, `true`, or `false`.
TRUST_PROXY=1

# __ Bella public URLs used to compose provider callbacks and return URLs _______
# Public. Base URL for this payment-service as seen by browsers and providers.
PAYMENT_PUBLIC_BASE_URL=http://localhost:3004
# Public. Base URL for the Bella frontend return page.
FRONTEND_PUBLIC_URL=http://localhost:5173
# Derived, not set directly:
# - webhook URL: ${PAYMENT_PUBLIC_BASE_URL}/payments/webhooks/${PAYMENT_PROVIDER}
# - generic webhook URL: ${PAYMENT_PUBLIC_BASE_URL}/payments/webhook?provider=${PAYMENT_PROVIDER}
# - frontend return URL: ${FRONTEND_PUBLIC_URL}/payments/return

# __ Payment behavior __________________________________________________________
# `mock` remains the safe default for local demo flows. `stripe` enables real hosted checkout in sandbox.
PAYMENT_PROVIDER=mock
PAYMENT_CHECKOUT_TTL_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Enable only on a MongoDB replica set so payment state and outbox inserts can commit atomically.
MONGODB_TRANSACTIONS_ENABLED=false

# __ Mock provider _____________________________________________________________
# Secret. Optional for localhost because payment-service falls back to
# `bella-mock-webhook-secret`, but set it explicitly in shared dev/staging.
MOCK_PAYMENT_WEBHOOK_SECRET=change_me_mock_webhook_secret

# __ Stripe sandbox ____________________________________________________________
# Secret. Required when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=sk_test_change_me
# Secret. Required when PAYMENT_PROVIDER=stripe.
STRIPE_WEBHOOK_SECRET=whsec_change_me
# Optional. Pin a Stripe API version for the Bella Stripe sandbox adapter. Leave blank to use SDK/account defaults.
STRIPE_API_VERSION=
