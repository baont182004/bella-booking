# Browser-visible service endpoints for local development.
# Copy to `frontend/.env` when you want the SPA to target non-default hosts or ports.

VITE_USER_SERVICE_URL=http://localhost:3001
VITE_HOTEL_SERVICE_URL=http://localhost:3002
VITE_BOOKING_SERVICE_URL=http://localhost:3003
VITE_PAYMENT_SERVICE_URL=http://localhost:3004

# Bella currently redirects to provider-hosted checkout URLs returned by the backend.
# A publishable provider key is not required until the frontend moves to a client SDK/tokenization flow.
