# Root environment for `docker compose`
# Copy to `.env` at the repository root before starting backend containers.

# MongoDB connection shared by user, hotel, booking, and payment services
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.tc3alix.mongodb.net/?appName=Cluster0

# JWT secret shared by user-service and every service that verifies auth tokens
JWT_SECRET=change_me_to_a_long_random_secret

# SMTP settings for notification-service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
