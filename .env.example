# Root environment for `docker compose` and repo-level local scripts.
# Copy to `.env` at the repository root before starting backend containers or running reset/seed helpers.

# __ Shared infrastructure _____________________________________________________
# Host machine MongoDB URI used by local scripts such as seeding/reset commands.
MONGODB_URI=mongodb://127.0.0.1:27017/bella_hotel
# In-container MongoDB URI used by docker compose services.
MONGODB_URI_DOCKER=mongodb://mongo:27017/bella_hotel
# Use localhost:9093 from the host because docker-compose exposes Kafka there.
# In-container services still talk to Kafka over `kafka:9092`.
KAFKA_BROKER=localhost:9093
REDIS_HOST=localhost
REDIS_PORT=6379

# __ Auth / browser origins ____________________________________________________
# Secret. Shared by every backend service that signs or verifies Bella JWTs.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=12h
# Public. Comma-separated browser origins allowed by backend CORS.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Internal deployment setting. Use the exact trusted proxy hop count, `true`, or `false`.
TRUST_PROXY=1

# __ Bella public URLs used by payment flows ___________________________________
# Public. Browser URL where the Bella SPA is served.
FRONTEND_PUBLIC_URL=http://localhost:5173
# Public. URL that external payment providers call back into for Bella payment routes.
PAYMENT_PUBLIC_BASE_URL=http://localhost:3004
# Derived, not set directly:
# - frontend return URL: ${FRONTEND_PUBLIC_URL}/payments/return
# - payment webhook URL: ${PAYMENT_PUBLIC_BASE_URL}/payments/webhooks/${PAYMENT_PROVIDER}
# - generic payment webhook URL: ${PAYMENT_PUBLIC_BASE_URL}/payments/webhook?provider=${PAYMENT_PROVIDER}

# __ Payment behavior shared by booking-service and payment-service _____________
# `mock` remains the safe default for local demo flows. `stripe` enables real hosted checkout in sandbox.
PAYMENT_PROVIDER=mock
PAYMENT_CHECKOUT_TTL_MINUTES=30
PAYMENT_HOLD_WINDOW_MINUTES=30
# Signature replay tolerance for webhook verification.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Keep `false` for simple local dev. Enable `true` only on a MongoDB replica set.
MONGODB_TRANSACTIONS_ENABLED=false

# __ Mock provider _____________________________________________________________
# Secret. Used only by the built-in mock provider. Optional for localhost because
# payment-service falls back to `bella-mock-webhook-secret`, but set it explicitly
# in shared dev/staging so webhook signatures stay predictable.
MOCK_PAYMENT_WEBHOOK_SECRET=change_me_mock_webhook_secret

# __ Stripe sandbox (required when PAYMENT_PROVIDER=stripe) _____________________
# Secret. Comes from Stripe Developers/API keys in test mode.
STRIPE_SECRET_KEY=sk_test_change_me
# Secret. Comes from the specific Stripe webhook endpoint after you register it.
STRIPE_WEBHOOK_SECRET=whsec_change_me
# Optional. Pin a Stripe API version for the Bella Stripe sandbox adapter. Leave blank to use SDK/account defaults.
STRIPE_API_VERSION=

# __ Notification service ______________________________________________________
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
