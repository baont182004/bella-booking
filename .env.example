# Root local-development example.
# Copy to `.env.local` when you need local overrides, then pass it to Docker Compose:
# docker compose --env-file .env.local up -d --build

NODE_ENV=development

# Public URLs / CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_PUBLIC_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3004
PAYMENT_PUBLIC_BASE_URL=http://localhost:3004
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Backward-compatible alias for older compose/service configs.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Local infrastructure
MONGO_URI=mongodb://127.0.0.1:27017/bella_hotel
MONGODB_URI=mongodb://127.0.0.1:27017/bella_hotel
MONGODB_URI_DOCKER=mongodb://mongo:27017/bella_hotel
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_BROKER=localhost:9093

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=12h
TRUST_PROXY=1

# Payment behavior
# `mock` supports hosted sandbox card and bank-transfer checkout for demos.
PAYMENT_PROVIDER=mock
PAYMENT_CHECKOUT_TTL_MINUTES=30
PAYMENT_HOLD_WINDOW_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# HMAC secret used only to verify mock provider webhook/callback payloads.
MOCK_PAYMENT_WEBHOOK_SECRET=change_me_mock_webhook_secret
MONGODB_TRANSACTIONS_ENABLED=false

# Stripe sandbox. Required only when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=

# Notification email. Required for real email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional helper/test configuration
BELLA_METADATA_FILE=./data/bella-room-metadata.json
USER_SERVICE_URL=http://localhost:3001
HOTEL_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004

# Optional demo admin bootstrap for local/demo environments.
ENABLE_DEMO_ADMIN_BOOTSTRAP=true
DEMO_ADMIN_SYNC_PASSWORD=true
DEMO_ADMIN_EMAIL=admin.bella@example.com
DEMO_ADMIN_PASSWORD=change_me_admin_password
DEMO_ADMIN_FIRST_NAME=Bella
DEMO_ADMIN_LAST_NAME=Admin
DEMO_ADMIN_PHONE=+84 900 000 001
